# Components
CONFIG_BFLB_LOG      =n
CONFIG_FREERTOS      =y
CONFIG_POSIX         =y
CONFIG_TLSF          =y
CONFIG_SHELL         =y
CONFIG_LWIP          =y
CONFIG_RF            =y
CONFIG_MBEDTLS       =y
CONFIG_DHCPD         =y
CONFIG_PING          =y

ifeq ($(CHIP),bl602)
    CONFIG_WIFI4=y
else
    CONFIG_WIFI6=y
    CONFIG_MACSW_SELECT = default
    CONFIG_WIFI_P2P ?= n
    ifeq ($(CONFIG_WL80211),y)
        CONFIG_BL_WPA_SUPPLICANT =y
        CONFIG_WL80211_WRAM_MEM_SIZE_LIMIT ?= 0x4000 # 16KB
    else
        CONFIG_FHOST=y
    endif
endif

ifeq ($(CHIP),bl618dg)
    CONFIG_WRAM_FOR_AP_SIZE ?= 0x28000
endif

CONFIG_VSNPRINTF_FLOAT      =y
CONFIG_VSNPRINTF_FLOAT_EX   =y
CONFIG_VSNPRINTF_LONG_LONG  =y


ifneq ($(CHIP),bl602)
CONFIG_MBEDTLS_AES_USE_HW    =y
CONFIG_MBEDTLS_ECC_USE_HW    =y
CONFIG_MBEDTLS_SHA1_USE_HW   =y
CONFIG_MBEDTLS_SHA256_USE_HW =y
CONFIG_MBEDTLS_SHA512_USE_HW =y
endif

CONFIG_LWIP_ALTCP =y
CONFIG_NETBUS =y
CONFIG_FOTA     =y
CONFIG_BFLB_MTD =y
CONFIG_PARTITION =y
CONFIG_POST_BUILDS_GENERATE_LITTLEFS =y
CONFIG_LITTLEFS =y
CONFIG_WIFI_IPERF =y

CONFIG_MBEDTLS_BIGNUM_USE_HW =n

CONFIG_ATMODULE              =y
CONFIG_ATMODULE_BASE         =y
CONFIG_ATMODULE_WIFI_STA     =y

ifeq ($(CONFIG_ATMODULE_ALL_FEAT),y)
CONFIG_ATMODULE_CHIP_TEMP =y
CONFIG_ATMODULE_CHIP_VBAT =y
CONFIG_ATMODULE_EFUSE     =y
CONFIG_ATMODULE_FLASH     =y
CONFIG_ATMODULE_GPIO      =y
CONFIG_ATMODULE_OTA       =y
endif

# wifi
ifeq ($(CONFIG_USE_LPAPP),y)
    CONFIG_LPAPP             =y
    CONFIG_PM                =y
    CONFIG_LWIP_LP           =y
    CONFIG_DCDC_ENABLE       =n
    CONFIG_TICKLESS_WIFI_BLE =y
    CONFIG_ATMODULE_LP       =y
    CONFIG_PWRMGMT           =y
    CONFIG_PM_HELPER_CLI     =y
    CONFIG_POST_BUILDS_CONCAT_WITH_LP_FW =y
    CONFIG_TICKLESS_EXT      =y
    CONFIG_TICKLESS_ACCURATE =y
else
#    CONFIG_IPV6 =y
endif

ifeq ($(CONFIG_BLUETOOTH_APP),y)
    CONFIG_BLUETOOTH =y
    CONFIG_BTBLECONTROLLER_LIB =ble1m10s1bredr0
    CONFIG_DISABLE_BT_HOST_PRIVACY =y
    CONFIG_DYNAMIC_GATTS =y
    CONFIG_DISABLE_BT_SMP =n
    CONFIG_BT_SETTINGS =y
    CONFIG_BLE_USE_MAC2 =n
    CONFIG_BT_STACK_CLI =n

    # BLE profile
    CONFIG_BT_BAS_SERVER =y
    CONFIG_BT_IAS_SERVER =y
    CONFIG_BT_DIS_SERVER =y
endif

ifeq ($(CHIP),bl602)
    CONFIG_POST_BUILDS_LITTLEFS_SIZE=0x47000
else ifeq ($(CHIP),bl616)
    CONFIG_POST_BUILDS_LITTLEFS_SIZE=0x71000
else
    CONFIG_POST_BUILDS_LITTLEFS_SIZE=0x71000
endif
