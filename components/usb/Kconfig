    bool "HID device class"
    default n
    depends on CHERRYUSB_DEVICE
    help
      Build the HID device class.

config CHERRYUSB_DEVICE_MSC
    bool "MSC device class"
    default n
    depends on CHERRYUSB_DEVICE
    help
      Build the mass storage device class.

config CHERRYUSB_DEVICE_AUDIO
    bool "Audio device class"
    default n
    depends on CHERRYUSB_DEVICE
    help
      Build the audio device class.

config CHERRYUSB_DEVICE_VIDEO
    bool "Video device class"
    default n
    depends on CHERRYUSB_DEVICE
    help
      Build the video (UVC) device class.

config CHERRYUSB_DEVICE_DFU
    bool "DFU device class"
    default n
    depends on CHERRYUSB_DEVICE
    help
      Build the device firmware update class.

config CHERRYUSB_DEVICE_GAMEPAD
    bool "Gamepad device class"
    default n
    depends on CHERRYUSB_DEVICE
    help
      Build the gamepad HID device class.

config CHERRYUSB_HOST
    bool "USB host stack"
    default n
    help
      Build the CherryUSB host stack.

config CHERRYUSB_HOST_CDC_ACM
    bool "CDC-ACM host class"
    default n
    depends on CHERRYUSB_HOST
    help
      Build the CDC-ACM serial host class.

config CHERRYUSB_HOST_CDC_ECM
    bool "CDC-ECM host class"
    default n
    depends on CHERRYUSB_HOST
