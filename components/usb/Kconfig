#
# USB components
#

menu "USB"

config CHERRYUSB
    bool "CherryUSB"
    default n
    help
      Build the CherryUSB protocol stack.

if CHERRYUSB

config CHERRYUSB_OSAL
    string "CherryUSB OS abstraction layer"
    default "freertos" if FREERTOS
    default ""
    help
      OSAL backend used by CherryUSB, for example freertos.

config CHERRYUSB_DEVICE
    bool "USB device stack"
    default n
    help
      Build the CherryUSB device stack.

config CHERRYUSB_DEVICE_CDC
    bool "CDC device class"
    default n
    depends on CHERRYUSB_DEVICE
    help
      Build the base CDC device class.

config CHERRYUSB_DEVICE_CDC_ACM
    bool "CDC-ACM device class"
    default n
    depends on CHERRYUSB_DEVICE
    help
      Build the CDC-ACM serial device class.

