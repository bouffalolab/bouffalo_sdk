#
# Graphics components
#

menu "Graphics"

config LVGL8
    bool "LVGL v8"
    default n
    help
      Build the LVGL v8 graphics library.

source "$BL_SDK_BASE/components/graphics/lvgl_v8/port/Kconfig"

config LVGL9
    bool "LVGL v9"
    default n
    help
      Build the LVGL v9 graphics library.

source "$BL_SDK_BASE/components/graphics/lvgl_v9/port/Kconfig"

config TJPGDEC
    bool "TJpgDec"
    default n
    help
      Build the Tiny JPEG decoder.

endmenu
