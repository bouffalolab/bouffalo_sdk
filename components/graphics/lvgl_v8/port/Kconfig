# LVGL v8 ports: display, input device and file system.
#
# Sourced by components/graphics/Kconfig, inside the "Graphics" menu after CONFIG_LVGL8.
# The display port of the default display of the display framework (CONFIG_DISPLAY_DEFAULT) is
# lvgl_v8/port/lv_port_disp_default_gram.c for a screen with frame memory and lv_port_disp_default_video.c for a
# video screen; the options of its draw buffers are here as well.

menu "LVGL v8 ports"
    depends on LVGL8

config LVGL8_PORT_DISP
    bool "LVGL v8 display port"
    default n
    help
      Build the LVGL v8 display driver port.

config LVGL8_DISP_DEFAULT_BUF_COUNT
    int "Number of draw buffers of the default display port"
    range 1 2
    default 2
    depends on LVGL8_PORT_DISP && DISPLAY_DEFAULT_TYPE_GRAM
    help
      Used when the display port is the one of the default display of the display framework
      (CONFIG_DISPLAY_DEFAULT) and the screen has frame memory (SPI / DBI / QSPI): the number of
      partial-rendering draw buffers, 1 or 2. With two, LVGL renders into one while the other is sent to the screen.
      A video screen (MIPI DSI / RGB) always uses two frame buffers in PSRAM with full-screen refresh.

config LVGL8_DISP_DEFAULT_BUF_SIZE
    int "Draw buffer size of the default display port (bytes)"
    default 76800 if PSRAM
    default 38400
    depends on LVGL8_PORT_DISP && DISPLAY_DEFAULT_TYPE_GRAM
    help
      Size of each partial-rendering draw buffer of a screen with frame memory, rounded up to a multiple of 64
      bytes. It has to hold at least one line of the display (a pixel is 2 bytes with RGB565 and 4 bytes with
      XRGB8888). The buffers are in internal RAM; with PSRAM enabled they are placed in PSRAM and the default is
      larger (76800 bytes: a quarter of a 320x480 RGB565 screen).
      Not used with a video screen: its buffers are whole frames.

config LVGL8_DISP_DEFAULT_SW_ROTATE
    bool "Software rotation of the default GRAM display"
    default n
    depends on LVGL8_PORT_DISP && DISPLAY_DEFAULT_TYPE_GRAM
    help
      Enable LVGL v8's built-in software rotation for the default display with frame memory
      (SPI / DBI / QSPI). Set the angle with lv_disp_set_rotation(); the initial angle is NONE.
      The port does not also rotate the panel in hardware.
      Not available for video displays: LVGL v8 does not support software rotation with full_refresh.

config LVGL8_PORT_INDEV
    bool "LVGL v8 input device port"
    default n
    help
      Build the LVGL v8 input device port.

config LVGL8_PORT_FS
    bool "LVGL v8 file system port"
    default n
    help
      Build the LVGL v8 file system port.

config LVGL8_OSD_LAYER
    bool "Legacy LCD OSD layer (deprecated)"
    default n
    depends on BSP_LCD && LVGL8_PORT_DISP
    help
      Use the legacy LCD OSD layer. Removed in the next major SDK release.

endmenu
