# LVGL v9 ports: display, input device and file system.
#
# Sourced by components/graphics/Kconfig, inside the "Graphics" menu after CONFIG_LVGL9.
# The display port of the default display of the display framework (CONFIG_DISPLAY_DEFAULT) is
# lvgl_v9/port/lv_port_disp_default_gram.c for a screen with frame memory and lv_port_disp_default_video.c for a
# video screen; the options of its draw buffers are here as well.

menu "LVGL v9 ports"
    depends on LVGL9

config LVGL9_PORT_DISP
    bool "LVGL v9 display port"
    default n
    help
      Build the LVGL v9 display driver port.

config LVGL9_DISP_DEFAULT_BUF_COUNT
    int "Number of draw buffers of the default display port"
    range 1 2
    default 2
    depends on LVGL9_PORT_DISP && DISPLAY_DEFAULT_TYPE_GRAM
    help
      Used when the display port is the one of the default display of the display framework
      (CONFIG_DISPLAY_DEFAULT) and the screen has frame memory (SPI / DBI / QSPI): the number of
      partial-rendering draw buffers, 1 or 2. With two, LVGL renders into one while the other is sent to the screen.
      A video screen (MIPI DSI / RGB) always uses two frame buffers in PSRAM, rendered in direct mode.

config LVGL9_DISP_DEFAULT_BUF_SIZE
    int "Draw buffer size of the default display port (bytes)"
    default 76800 if PSRAM
    default 38400
    depends on LVGL9_PORT_DISP && DISPLAY_DEFAULT_TYPE_GRAM
    help
      Size of each partial-rendering draw buffer of a screen with frame memory, rounded up to a multiple of 64
      bytes. It has to hold at least one line of the display (a pixel is 2 bytes with RGB565, 3 bytes with RGB888
      and 4 bytes with XRGB8888). The buffers are in internal RAM; with PSRAM enabled they are placed in PSRAM and
      the default is larger (76800 bytes: a quarter of a 320x480 RGB565 screen).
      Not used with a video screen: its buffers are whole frames.

config LVGL9_PORT_INDEV
    bool "LVGL v9 input device port"
    default n
    help
      Build the LVGL v9 input device port.

config LVGL9_PORT_FS
    bool "LVGL v9 file system port"
    default n
    help
      Build the LVGL v9 file system port.


config LVGL9_OSD_LAYER
    bool "Legacy LCD OSD layer (deprecated)"
    default n
    depends on BSP_LCD && LVGL9_PORT_DISP
    help
      Use the legacy LCD OSD layer. Removed in the next major SDK release.

endmenu
