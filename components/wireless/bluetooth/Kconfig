    bool "A2DP source role"
    default n
    depends on BT_A2DP
    help
      Enable the A2DP source role.

config BT_A2DP_SINK
    bool "A2DP sink role"
    default y
    depends on BT_A2DP
    help
      Enable the A2DP sink role.

config BT_AVRCP
    bool "AVRCP"
    default y if BT_BREDR
    help
      Enable the Audio/Video Remote Control Profile.

