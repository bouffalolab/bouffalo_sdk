    bool
    default n
    help
      Enable handling of the remote version information request.

comment "Host stack"

# BT_CONN and BLE_TX_BUFF_DATA are fixed by the prebuilt controller library
# (set via the per-library controller presets in ble_common_readonly.cmake).
# They intentionally have no prompt so they are not user-editable in
# menuconfig.

config BT_CONN
    int
    default 1
    help
      Maximum number of simultaneous ACL connections. Must match the
      configuration of the prebuilt controller library.

config BLE_TX_BUFF_DATA
    int
    default 2
    help
      Number of BLE TX data buffers. Must match the configuration of the
      prebuilt controller library.

# Fixed by the prebuilt controller library presets, like BT_CONN above.
config BLE_ACT_MAX
    int
    default 7
    help
      Maximum number of BLE advertising instances. Updating advertising
      data while advertising is active requires at least 4 buffers.

config BT_ATT_PREPARE_COUNT
    int "ATT prepare write queue count"
    default 0
    range 0 64
    help
      Number of queued ATT prepare write requests.

