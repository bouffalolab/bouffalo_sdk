    depends on BT_BREDR
    help
      Enable the Serial Port Profile.

config BT_RESET
    bool "Bluetooth controller reset"
    default n
    help
      Enable resetting the Bluetooth controller.

config BT_L2CAP_DYNAMIC_CHANNEL
    bool "L2CAP dynamic channel"
    depends on BT_BREDR
    default y
    help
      Enable BR/EDR L2CAP dynamic channel support. This is always enabled
      when BR/EDR is enabled and matches the compile definitions the stack
      has always received; disable it only if your controller library was
      built without BR/EDR L2CAP dynamic channel support.

# Controller features
#
# These symbols describe capabilities baked into the prebuilt Bluetooth
# controller library (selected via the blecontroller/btblecontroller
# component and PRIV_CONFIG_GEN_BLE) rather than something a host-side
# project can freely turn on or off. They intentionally have no prompt so
# they do not show up as user-editable entries in menuconfig; their
# effective values come from the per-library controller presets in
# ble_common_readonly.cmake (_check_conflict) or from the defaults below
# when no preset overrides them.

config BT
    bool
    default y if BT_BREDR
    default n
    help
      Enable the BR/EDR part of the Bluetooth controller.

config SCO_ESCO
    bool
    default y
    help
      Enable SCO and eSCO synchronous connection support.

config PCA
    bool
    default y
    help
      Enable power control adjustments.

config RF_EXTRC
    bool
    default y
    help
      Enable external RF test support.

config CSB
    bool
    default y
    help
      Enable connectionless slave broadcast support.

config SNIFF
    bool
    default y
    help
      Enable BR/EDR sniff mode.

config RSWITCH
    bool
    default y
    help
      Enable BR/EDR role switch.

config TEST_MODE
    bool
    default y
    help
      Enable controller test mode support.

config BT_HCI_TEST_MODE
    bool
    default y
    help
      Enable HCI test mode support.

config BT_DIRECT_TEST_MODE
    bool
    default y
    help
      Enable BLE direct test mode support.

config BLE
    bool
    default y
    help
      Enable the BLE part of the Bluetooth controller.

config CIS
    bool
    default y
    help
      Enable connected isochronous stream support.

config ADV_EXTENSION
    bool
    default y
    help
      Enable extended advertising support.

config BIS
    bool
    default y
    help
      Enable broadcast isochronous stream support.

config LONG_RANG
    bool
    default y
    help
      Enable BLE long range (coded PHY) support.

config LE_PWR_CTRL
    bool
    default y
    help
      Enable LE power control support.

config CTE
    bool
    default y
    help
      Enable constant tone extension support.

config PHY_UPDATE
    bool
    default y
    help
      Enable the LL_PHY_UPDATE procedure.

config CLK_ACC
    bool
    default y
    help
      Enable clock accuracy support.

