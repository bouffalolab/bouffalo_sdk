config BLUETOOTH
    bool "Bluetooth stack"
    default n
    help
      Anchor for the Bluetooth menu. The Bluetooth stack build itself is
      controlled by the bluetooth component and the controller library
      selection, not by this flag.

comment "BR/EDR (Classic)"

config BT_BREDR
    bool "BR/EDR (Classic) support"
    default n
    help
      Enable Bluetooth BR/EDR (Classic) support. Selecting this pulls in
      the BR/EDR controller features and the classic Bluetooth profiles.
      Note: the prebuilt controller library may force this option for
      certain controller library variants.

config BT_A2DP
    bool "A2DP"
    default y if BT_BREDR
    help
      Enable the Advanced Audio Distribution Profile.

