#
# IPC components
#

menu "Inter-Processor Communication"

config IPC
    bool "IPC framework"
    default n
    help
      Build the inter-processor communication framework.

config OPENAMP_RPMSG_BUFFER_SIZE
    int "RPMsg buffer size (bytes)"
    range 512 65535
    default 512
    depends on IPC
    help
      Size of each RPMsg buffer, including the RPMsg header. Applies to all
      RPMsg services and must match on communicating cores. Shared RAM must
      accommodate 2 * VRING_SIZE buffers and vring metadata.

config RPMSG_SERVICE
    bool "RPMsg service"
    default n
    depends on IPC
    help
      Build the RPMsg based service layer used by multi-core applications.

config RPMSG_SERVICE_MODE_MASTER
    bool "RPMsg service master mode"
    default n
    depends on RPMSG_SERVICE
    help
      Run the RPMsg service in master mode; leave disabled for slave mode.

config OPENAMP_PROXY
    bool "OpenAMP proxy"
    default n
    help
      Build the OpenAMP proxy service.

config OPENAMP_VIRTIO_DEVICE_SUPPORT
    bool "OpenAMP virtio device"
    default n
    help
      Enable virtio device support in OpenAMP.

config OPENAMP_VIRTIO_DRIVER_SUPPORT
    bool "OpenAMP virtio driver"
    default n
    help
      Enable virtio driver support in OpenAMP.

endmenu
