# Default display
#
# Defines one display from Kconfig, for the common case of a single screen that needs no special
# configuration: a screen with its own frame memory (SPI / DBI / QSPI), or a video screen (MIPI DSI / RGB). The
# application (or the LVGL port) gets it with display_default_get() and drives it like any other display. Projects with
# several screens, or with special needs, define their displays in C and write their own port instead.
#
# CS is a software GPIO by default: the board pin functions (default/display_default_gpio_ext.h) never mux a CS pin to
# the controller on their own. A panel without CS, or with CS driven by the DBI hardware, is a choice below.
# Optional pins are a "used" switch plus a pin number (the SDK Kconfig generator writes negative numbers as
# strings, so -1 cannot mean "none"). Backlight, reset and power can also be implemented by the project
# (for example on an I/O expander); CS cannot: it is always a GPIO, driven by the software or by the DBI hardware
# (see the choice).

menuconfig DISPLAY_DEFAULT
    bool "Default display (one screen defined from Kconfig)"
    default n
    help
      Define the display returned by display_default_get(). Pixel format, wire width, clock, command
      encoding and the rest of the settings come from the interface and the panel IC.

if DISPLAY_DEFAULT

choice DISPLAY_DEFAULT_TYPE
    prompt "Screen type"
    default DISPLAY_DEFAULT_TYPE_GRAM
config DISPLAY_DEFAULT_TYPE_GRAM
    bool "Screen with frame memory (SPI / DBI / QSPI), pixels pushed with display_draw()"
config DISPLAY_DEFAULT_TYPE_VIDEO
    bool "Video screen (MIPI DSI / RGB), frames scanned out and switched with display_flip()"
    depends on CHIP = "bl618dg"
    select DISPLAY_SCANOUT_BL618DG_DPU
endchoice

if DISPLAY_DEFAULT_TYPE_GRAM

choice DISPLAY_DEFAULT_IFACE
    prompt "Interface"
    default DISPLAY_DEFAULT_IF_SPI
    help
      The interface the panel is wired to. The board (bsp/board/<board>) provides its pin function, see
      default/display_default_gpio_ext.h; a missing one is a link error.
config DISPLAY_DEFAULT_IF_SPI
    bool "Hardware SPI (DBI Type C 4-wire)"
    select DISPLAY_BUS_SPI
config DISPLAY_DEFAULT_IF_DBI_C4
    bool "DBI peripheral, Type C 4-wire (SCL + SDA + D/C)"
    depends on CHIP = "bl616" || CHIP = "bl616cl" || CHIP = "bl618dg"
    select DISPLAY_BUS_DBI
config DISPLAY_DEFAULT_IF_DBI_B8
    bool "DBI peripheral, Type B (8080 x8)"
    depends on CHIP = "bl616" || CHIP = "bl616cl" || CHIP = "bl618dg"
    select DISPLAY_BUS_DBI
config DISPLAY_DEFAULT_IF_QSPI
    bool "DBI peripheral, QSPI"
    depends on CHIP = "bl616" || CHIP = "bl616cl" || CHIP = "bl618dg"
    select DISPLAY_BUS_DBI
endchoice

