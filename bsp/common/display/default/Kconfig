# Panels with a driver IC (a command port): the module can be changed with display_default_get_module()
config DISPLAY_DEFAULT_VIDEO_DCS
    bool
    default y if DISPLAY_DEFAULT_DSI || DISPLAY_DEFAULT_RGB_CMD

config DISPLAY_DEFAULT_DSI_LANES
    int "Data lanes wired on the board"
    range 1 4
    default 2
    depends on DISPLAY_DEFAULT_DSI
    help
      1, 2 or 4. It has to be at least the number of lanes of the panel module; the default is the number of lanes of
      the panel selected above.

