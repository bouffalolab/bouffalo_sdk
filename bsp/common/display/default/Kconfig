    int "Command port data GPIO"
    range 0 63
    depends on !DISPLAY_DEFAULT_RGB_CMD_NONE

config DISPLAY_DEFAULT_RGB_CMD_CS_PIN
    int "Command port CS GPIO (active low)"
    range 0 63
    depends on !DISPLAY_DEFAULT_RGB_CMD_NONE

config DISPLAY_DEFAULT_RGB_CMD_DC_PIN
    int "Command port D/C GPIO (high: data)"
    range 0 63
