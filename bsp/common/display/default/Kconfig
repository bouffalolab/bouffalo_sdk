config DISPLAY_DEFAULT_MODULE_CUSTOM
    bool "Custom (the project defines display_default_custom_module)"
    help
      The project provides `const display_dcs_module_t display_default_custom_module`, a module description
      like panel/template/display_module_template.c.
endchoice

choice DISPLAY_DEFAULT_FORMAT
    prompt "Pixel format in memory"
    default DISPLAY_DEFAULT_FORMAT_RGB565
config DISPLAY_DEFAULT_FORMAT_RGB565
    bool "RGB565"
config DISPLAY_DEFAULT_FORMAT_XRGB8888
    bool "XRGB8888"
config DISPLAY_DEFAULT_FORMAT_RGB888
    bool "RGB888, packed 3 bytes per pixel"
    depends on !DISPLAY_DEFAULT_IF_SPI
    help
      Saves a quarter of the memory of XRGB8888. The DBI peripheral converts it; the hardware SPI backend does
      not support this format.
endchoice

choice DISPLAY_DEFAULT_WIRE
    prompt "Pixel format on the wire"
    default DISPLAY_DEFAULT_WIRE_AUTO
    help
      Independent of the pixel format in memory. AUTO uses 16 bits per pixel for RGB565 and
      24 bits per pixel for RGB888/XRGB8888. The DBI peripheral can convert between input and
      output formats; hardware SPI always derives its wire format from the memory format.
config DISPLAY_DEFAULT_WIRE_AUTO
    bool "Auto (derive from memory format)"
config DISPLAY_DEFAULT_WIRE_16
    bool "16 bits per pixel (RGB565)"
    depends on !DISPLAY_DEFAULT_IF_SPI
config DISPLAY_DEFAULT_WIRE_24
    bool "24 bits per pixel (RGB888/RGB666)"
    depends on !DISPLAY_DEFAULT_IF_SPI
endchoice

config DISPLAY_DEFAULT_DEV
    string "Controller device name"
    default "spi0" if DISPLAY_DEFAULT_IF_SPI
    default "dbi"

config DISPLAY_DEFAULT_DMA
    string "DMA channel for the pixels (empty: CPU only)"
    default "dma0_ch3"

config DISPLAY_DEFAULT_LLI_COUNT
    int "DMA list nodes"
    range 1 255
    default 40
    help
      16 bytes per node. One draw can carry up to about 16 KB per node on the DBI peripheral and 8 KB per node
      on SPI (RGB565); 40 nodes cover a full 320x480 RGB565 frame on both. display_get_info() reports the limit
      as max_draw_bytes.

config DISPLAY_DEFAULT_FREQ_HZ
    int "Clock (Hz, 0: interface default)"
    default 0
    help
      0 selects the default of the interface: 27 MHz for Type B, 40 MHz otherwise.

choice DISPLAY_DEFAULT_CS_MODE
    prompt "Chip select"
    default DISPLAY_DEFAULT_CS_GPIO
    help
      How the panel is selected. The panel is the only one on its bus, so it may also be always selected.
config DISPLAY_DEFAULT_CS_GPIO
    bool "Software CS (GPIO, active low)"
    help
      The framework drives a GPIO around every transaction. It is released in the DMA completion interrupt,
      so it has to be a real GPIO (an I/O expander behind I2C cannot do that). Other kinds of CS are not supported.
config DISPLAY_DEFAULT_CS_HARDWARE
    bool "Hardware CS (the same GPIO, driven by the DBI controller)"
    depends on !DISPLAY_DEFAULT_IF_SPI
    help
      The CS pin of the interface is muxed to the DBI controller (board function board_display_<interface>_cs_gpio_init)
      and driven by the hardware; the software does nothing. Only the DBI peripheral supports it.
config DISPLAY_DEFAULT_CS_NONE
    bool "No CS (the panel is always selected)"
    help
      CS is not wired, or tied to ground on the panel module.
endchoice

config DISPLAY_DEFAULT_CS_PIN
    int "CS GPIO (active low)"
    range 0 63
    depends on DISPLAY_DEFAULT_CS_GPIO
    help
      Set this to a free GPIO wired to the panel CS. The board pin functions leave that pin as a plain GPIO.

config DISPLAY_DEFAULT_DC_PIN
    int "D/C GPIO of the SPI interface (high: data)"
    range 0 63
    depends on DISPLAY_DEFAULT_IF_SPI

endif # DISPLAY_DEFAULT_TYPE_GRAM

