config DISPLAY_DEFAULT_BOARD_CUSTOM
    bool "Power, reset and backlight implemented by the project"
    default n
    help
      The project provides `const display_board_ops_t display_default_board_ops` (power, reset and backlight
      callbacks, for example on an I/O expander or a PWM); the pins of this menu are not used.

config DISPLAY_DEFAULT_RESET_USED
    bool "Panel reset pin"
    default n
    depends on !DISPLAY_DEFAULT_BOARD_CUSTOM

config DISPLAY_DEFAULT_RESET_PIN
    int "Reset GPIO (active low)"
    range 0 63
    depends on DISPLAY_DEFAULT_RESET_USED

config DISPLAY_DEFAULT_POWER_USED
    bool "Panel power enable pin"
    default n
    depends on !DISPLAY_DEFAULT_BOARD_CUSTOM

config DISPLAY_DEFAULT_POWER_PIN
    int "Power enable GPIO (active high)"
    range 0 63
    depends on DISPLAY_DEFAULT_POWER_USED

choice DISPLAY_DEFAULT_BACKLIGHT_MODE
    prompt "Backlight"
    default DISPLAY_DEFAULT_BACKLIGHT_NONE
    depends on !DISPLAY_DEFAULT_BOARD_CUSTOM
    help
      A GPIO backlight, switched with display_set_backlight(): any level above 0 is on. The backlight is off
      after display_init(). For a PWM or I/O expander backlight use "Power, reset and backlight implemented by
      the project" above and set the backlight callback of display_default_board_ops.

config DISPLAY_DEFAULT_BACKLIGHT_NONE
    bool "None"
config DISPLAY_DEFAULT_BACKLIGHT_GPIO
    bool "GPIO"
endchoice

config DISPLAY_DEFAULT_BACKLIGHT_PIN
    int "Backlight GPIO"
    range 0 63
    depends on DISPLAY_DEFAULT_BACKLIGHT_GPIO

config DISPLAY_DEFAULT_BACKLIGHT_ACTIVE_HIGH
    bool "Backlight is on when the pin is high"
    default y
    depends on DISPLAY_DEFAULT_BACKLIGHT_GPIO

endif # DISPLAY_DEFAULT
