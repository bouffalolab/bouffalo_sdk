    bool "ST7735 (240x320)"
    depends on DISPLAY_PANEL_ST7735
config DISPLAY_DEFAULT_MODULE_ST77922_320X480
    bool "ST77922 320x480 (DBI)"
    depends on DISPLAY_PANEL_ST77922
config DISPLAY_DEFAULT_MODULE_ST77926_320X480
    bool "ST77926 320x480 (QSPI)"
    depends on DISPLAY_PANEL_ST77922
