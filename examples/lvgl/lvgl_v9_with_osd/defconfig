CONFIG_PSRAM = y
CONFIG_PSRAM_FOR_AP_SIZE = 0x1000000
CONFIG_FREERTOS = y
CONFIG_LVGL9 = y
CONFIG_LVGL9_PORT_DISP = y
CONFIG_LVGL9_OSD_LAYER = y
CONFIG_BSP_LCD = y
CONFIG_DPI_DISPLAY_BOARD_MODE = y

# Default is the original SD-card JPEG video path. Build with
# CONFIG_LVGL_V9_WITH_OSD_USB_VIDEO=y to use USB DATA ACM + NetHub instead.
CONFIG_LVGL_V9_WITH_OSD_USB_VIDEO = n

ifeq ($(CONFIG_LVGL_V9_WITH_OSD_USB_VIDEO),y)
    -include $(BL_SDK_BASE)/examples/wifi/defconfig
    CONFIG_WIFI_IPERF = y

    CONFIG_BSP_USB = y
    CONFIG_CHERRYUSB = y
    CONFIG_CHERRYUSB_OSAL = freertos
    CONFIG_CHERRYUSB_DEVICE = y
    CONFIG_CHERRYUSB_DEVICE_CDC = y
    CONFIG_CHERRYUSB_DEVICE_CDC_ECM = y
    CONFIG_CHERRYUSB_DEVICE_CDC_ACM = y

    CONFIG_NETHUB = y
    CONFIG_NETHUB_PROFILE_USB = y
    CONFIG_NETHUB_PROFILE_SDIO = n
    CONFIG_NETHUB_CTRLCHANNEL_USE_ATMODULE = n
    CONFIG_NETHUB_LOWPOWER_ENABLE = n
else
    CONFIG_FATFS = y
    CONFIG_FATFS_SDH_SDCARD = y
    CONFIG_BSP_SDH_SD = y
endif
