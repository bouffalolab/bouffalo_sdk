ifneq ($(CHIP),bl618dg)
    $(error EK79007 DSI requires CHIP=bl618dg)
endif
ifneq ($(CPU_ID),ap)
    $(error EK79007 DSI requires CPU_ID=ap)
endif

CONFIG_BFLB_LOG=n
CONFIG_PSRAM=y
CONFIG_PSRAM_FOR_AP_SIZE=0x1000000
CONFIG_FREERTOS=y

# LVGL v8
CONFIG_LVGL8=y
CONFIG_LVGL8_PORT_DISP=y
CONFIG_LVGL8_PORT_INDEV=n
CONFIG_LVGL8_PORT_FS=n

# EK79007 1024x600 on MIPI DSI, two lanes
CONFIG_BSP_DISPLAY=y
CONFIG_DISPLAY_DEFAULT=y
CONFIG_DISPLAY_DEFAULT_TYPE_VIDEO=y
CONFIG_DISPLAY_DEFAULT_VIDEO_EK79007_2LANE=y
CONFIG_DISPLAY_DEFAULT_DSI_LANES=2
CONFIG_DISPLAY_DEFAULT_VIDEO_FORMAT_RGB565=y
CONFIG_DISPLAY_DEFAULT_RESET_USED=y
CONFIG_DISPLAY_DEFAULT_RESET_PIN=2
CONFIG_DISPLAY_DEFAULT_BACKLIGHT_NONE=y