ifeq ($(filter $(CHIP),bl616 bl616cl bl618dg),)
    $(error ST7796 DBI requires CHIP=bl616, bl616cl or bl618dg)
endif

CONFIG_BFLB_LOG=n
CONFIG_PSRAM=n
CONFIG_FREERTOS=y

# LVGL v8
CONFIG_LVGL8=y
CONFIG_LVGL8_PORT_DISP=y
CONFIG_LVGL8_PORT_INDEV=n
CONFIG_LVGL8_PORT_FS=n
CONFIG_LVGL8_DISP_DEFAULT_BUF_COUNT=2
CONFIG_LVGL8_DISP_DEFAULT_BUF_SIZE=38400

# ST7796 320x480 on DBI Type B
CONFIG_BSP_DISPLAY=y
CONFIG_DISPLAY_BUS_DBI=y
CONFIG_DISPLAY_BUS_SPI=n
CONFIG_DISPLAY_DEFAULT=y
CONFIG_DISPLAY_DEFAULT_TYPE_GRAM=y
CONFIG_DISPLAY_DEFAULT_IF_DBI_B8=y
CONFIG_DISPLAY_DEFAULT_MODULE_ST7796_320X480=y
CONFIG_DISPLAY_DEFAULT_FORMAT_RGB565=y
CONFIG_DISPLAY_DEFAULT_DMA="dma0_ch3"
CONFIG_DISPLAY_DEFAULT_LLI_COUNT=20
CONFIG_DISPLAY_DEFAULT_CS_GPIO=y
CONFIG_DISPLAY_DEFAULT_RESET_USED=n

ifeq ($(CHIP),bl616)
    CONFIG_DISPLAY_DEFAULT_CS_PIN=5
    CONFIG_DISPLAY_DEFAULT_BACKLIGHT_GPIO=y
    CONFIG_DISPLAY_DEFAULT_BACKLIGHT_PIN=17
else ifeq ($(CHIP),bl616cl)
    CONFIG_DISPLAY_DEFAULT_CS_PIN=0
    CONFIG_DISPLAY_DEFAULT_BACKLIGHT_NONE=y
else
    CONFIG_DBI_DISPLAY_BOARD_MODE=n
    CONFIG_DISPLAY_DEFAULT_CS_PIN=18
    CONFIG_DISPLAY_DEFAULT_BACKLIGHT_NONE=y
endif