# ILI9341 240x320 on hardware SPI; CS GPIO5, D/C GPIO16.
CONFIG_BFLB_LOG=n
CONFIG_PSRAM=n
CONFIG_FREERTOS=y

# LVGL v9
CONFIG_LVGL9=y
CONFIG_LVGL9_PORT_DISP=y
CONFIG_LVGL9_PORT_INDEV=n
CONFIG_LVGL9_PORT_FS=n
CONFIG_LVGL9_DISP_DEFAULT_BUF_COUNT=1
CONFIG_LVGL9_DISP_DEFAULT_BUF_SIZE=19200

# Default SPI display
CONFIG_BSP_DISPLAY=y
CONFIG_DISPLAY_BUS_SPI=y
CONFIG_DISPLAY_BUS_DBI=n
CONFIG_DISPLAY_DEFAULT=y
CONFIG_DISPLAY_DEFAULT_TYPE_GRAM=y
CONFIG_DISPLAY_DEFAULT_IF_SPI=y
CONFIG_DISPLAY_DEFAULT_MODULE_ILI9341_240X320=y
CONFIG_DISPLAY_DEFAULT_FORMAT_RGB565=y
CONFIG_DISPLAY_DEFAULT_CS_GPIO=y
CONFIG_DISPLAY_DEFAULT_CS_PIN=5
CONFIG_DISPLAY_DEFAULT_DC_PIN=16
CONFIG_DISPLAY_DEFAULT_RESET_USED=n
CONFIG_DISPLAY_DEFAULT_BACKLIGHT_NONE=y
