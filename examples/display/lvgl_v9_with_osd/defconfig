ifneq ($(CHIP),bl618dg)
	$(error This example supports CHIP=bl618dg only)
endif
ifneq ($(CPU_ID),ap)
	$(error This example requires CPU_ID=ap)
endif

CONFIG_PSRAM = y
CONFIG_PSRAM_FOR_AP_SIZE = 0x1000000
CONFIG_FREERTOS = y
CONFIG_LVGL9 = y
CONFIG_LVGL9_PORT_DISP = y
CONFIG_BSP_DISPLAY = y
CONFIG_DISPLAY_DEFAULT = y
CONFIG_DISPLAY_DEFAULT_TYPE_VIDEO = y
# The video-module Kconfig choice defaults to EK79007_2LANE (1024x600),
# with DISPLAY_DEFAULT_DSI_LANES=2. Do not force the choice or lane count here:
# another CONFIG_DISPLAY_DEFAULT_VIDEO_* = y must also work from the command line.
CONFIG_DISPLAY_DEFAULT_VIDEO_FORMAT_ARGB8888 = y
CONFIG_DISPLAY_DEFAULT_RESET_USED = y
CONFIG_DISPLAY_DEFAULT_RESET_PIN = 2
CONFIG_DISPLAY_DEFAULT_BACKLIGHT_NONE = y

# Default is the original SD-card JPEG video path. Build with
# CONFIG_LVGL_V9_WITH_OSD_USB_VIDEO=y to use USB DATA ACM + NetHub instead.
CONFIG_LVGL_V9_WITH_OSD_USB_VIDEO = n
CONFIG_LVGL_V9_WITH_OSD_OTA = n

ifneq ($(filter y,$(CONFIG_LVGL_V9_WITH_OSD_USB_VIDEO) $(CONFIG_LVGL_V9_WITH_OSD_OTA)),)
	-include $(BL_SDK_BASE)/examples/wifi/defconfig
endif

ifeq ($(CONFIG_LVGL_V9_WITH_OSD_OTA),y)
	CONFIG_OVERRIDE_PTFILE = "partition_ota_8M.toml"
	CONFIG_PARTITION = y
	CONFIG_BFLB_MTD = y
	CONFIG_FOTA = y
	CONFIG_FOTA_NO_SHELL = y
	CONFIG_FAST_OTA = 0
	CONFIG_HTTP = y
	CONFIG_HTTP_CLIENT = y
	CONFIG_PROJECT_SDK_VERSION = "1.0.0"
	CONFIG_OTA_HEADER_USE_SDK_VERSION = y
endif

ifeq ($(CONFIG_LVGL_V9_WITH_OSD_USB_VIDEO),y)
	CONFIG_WIFI_IPERF = y

	CONFIG_BSP_USB = y
	CONFIG_CHERRYUSB = y
	CONFIG_CHERRYUSB_OSAL = freertos
	CONFIG_CHERRYUSB_DEVICE = y
	CONFIG_CHERRYUSB_DEVICE_CDC = y
	CONFIG_CHERRYUSB_DEVICE_CDC_ECM = y
	CONFIG_CHERRYUSB_DEVICE_CDC_ACM = y

	CONFIG_NETHUB = y
	CONFIG_NETHUB_PROFILE_USB = y
	CONFIG_NETHUB_PROFILE_SDIO = n
	CONFIG_NETHUB_CTRLCHANNEL_USE_ATMODULE = n
	CONFIG_NETHUB_LOWPOWER_ENABLE = n
else
	CONFIG_FATFS = y
	CONFIG_FATFS_SDH_SDCARD = y
	CONFIG_BSP_SDH_SD = y
endif