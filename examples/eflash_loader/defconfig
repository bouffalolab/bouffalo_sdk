CONFIG_ROMAPI               = y
CONFIG_XZ                   = y
CONFIG_GCC_OPTIMISE_LEVEL   = -Os

# These are enabled by default for BL618DG in bsp/board/Kconfig; the loader
# needs neither, and leaving them on pulls in the multimedia LHAL
# drivers and inflates the RAM image.
CONFIG_MULTIMEDIA_VIDEO     = n

CONFIG_DEBUG                = n
CONFIG_COREDUMP             = n

# The loader is a RAM-resident JTAG image that owns its own startup (clock,
# NP/LP halt, flash probe) and never uses the SDK heap.  Keep the default
# board SYSINIT sequence out of the image: its heap registration needs an
# allocator, which this build intentionally leaves out.
CONFIG_SYSINIT              = n
CONFIG_TLSF                 = n
CONFIG_MEM_TLSF_EN          = n
CONFIG_BFLB_LOG             = n
