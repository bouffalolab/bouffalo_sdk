mainmenu "SDK Configuration"

source "$BL_SDK_BASE/Kconfig"

menu "Example Configuration"

config EXAMPLE_PM_GPIO_WAKEUP
    bool "Enable GPIO wakeup"
    default y
    help
      Enable board-configured low-power GPIO wakeup. GPIO0-GPIO7 can wake
      PDS and HBN; GPIO8-GPIO52 can wake PDS only.

config EXAMPLE_PM_BOD_WAKEUP
    bool "Enable BOD wakeup"
    default y
    help
      Enable BOD as a wakeup source in PDS and HBN modes.

config EXAMPLE_PM_BOD_THRESHOLD
    int "BOD threshold selector"
    depends on EXAMPLE_PM_BOD_WAKEUP
    range 0 7
    default 7
    help
      BL618DG BOD threshold selector passed to AON_Set_BOD_Config(). The
      selector-to-voltage mapping documented by the BL618DG AON driver is:

        0 = 2.05 V, 1 = 2.10 V, 2 = 2.15 V, 3 = 2.20 V
        4 = 2.25 V, 5 = 2.30 V, 6 = 2.35 V, 7 = 2.40 V

      The default value 7 selects approximately 2.40 V. Actual threshold
      voltage varies with device, supply, and temperature.

config EXAMPLE_PM_KEYSCAN_WAKEUP
    bool "Enable keyscan wakeup"
    default y
    help
      Enable the PDS key detector. Keyscan is not available as an HBN wakeup
      source.

config EXAMPLE_PM_KEYSCAN_POLL_MODE
    bool "Use polling mode for keyscan demo"
    depends on EXAMPLE_PM_KEYSCAN_WAKEUP
    default n
    help
      Use the blocking keyscan query API while waiting for two key presses
      before shell startup. If disabled, keyscan interrupts are used instead.

config EXAMPLE_PM_RTC_WAKEUP
    bool "Enable RTC wakeup"
    default y
    help
      Enable relative RTC wakeup in PDS and HBN modes. PDS receives RTC wakeup
      through HBN_IRQ_OUT. The PDS timer wakeup source can also be selected at
      runtime by passing "timer" as the last app_pm_enter argument.

config EXAMPLE_PM_AON_WDT
    bool "Enable AON watchdog"
    default y
    help
      Enable the BL618DG AON-domain watchdog with a two-second timeout. The
      demo feeds it every 500 ms while active and immediately before entering
      PDS or HBN. A PDS sleep longer than two seconds should cause an AON
      watchdog reset before the configured timer wakeup. The README also uses
      this option to determine whether the watchdog remains active in HBN0.

endmenu
